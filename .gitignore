# ═══════════════════════════════════════════════════════════════════════════════
# Nexus OS — Root .gitignore
# Covers: Java/Maven, Next.js/Node, Python (LLM scripts), Docker, IDEs
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Java / Maven ─────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
*.log
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper downloaded files
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/MavenWrapperDownloader.java

# ─── Next.js / Node.js ───────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Python (Local LLM Scripts) ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env/
.conda/
*.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# ─── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
.DS_Store
Thumbs.db
Desktop.ini

# ─── OS Generated ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*.pid
*.seed
*.pid.lock
coverage/
.nyc_output/

# ═══════════════════════════════════════════════════════════════════════════════
# Coordination & Local-Only Agent Files
# These exist locally for AI agents to coordinate (read history, claim files,
# record decisions). They never appear on GitHub — the public repo only sees
# actual code changes authored by Aryan Singh.
# ═══════════════════════════════════════════════════════════════════════════════

# Master coordination
/COORDINATION.md

# Root-level agent entry points (frontend/AGENTS.md and frontend/CLAUDE.md are
# different files — they live inside /frontend and ARE committed because they
# only contain Next.js 16 advisory notes).
/CLAUDE.md
/GEMINI.md
/AGENTS.md
/plan.md

# Per-agent context directories
/.antigravitycli/
/.claude/
/.cursor/
/.windsurf/
/.codex/

# Local memory + scratch
/memory/
/.notes/

# Git hooks bootstrapper (hooks themselves live under .githooks; we ignore
# the directory entirely so it never lands on GitHub)
/.githooks/

# ─── Build artifacts not previously covered ──────────────────────────────────
/test-results.log
/test-results/
/playwright-report/
/blob-report/
backend/target/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# ─── Backend Spring Boot local + observability ───────────────────────────────
backend/logs/
backend/heap-dumps/
backend/HELP.md
backend/.spring-boot-devtools.properties

# ─── Docker overrides (per-developer) ─────────────────────────────────────────
docker-compose.override.*.yml
!docker-compose.override.example.yml

# ─── Prometheus / Grafana / Jaeger local storage ─────────────────────────────
/observability/data/
/observability/grafana-data/
/observability/prometheus-data/

# ─── Generated diagrams (PlantUML PNG outputs — keep .puml source) ───────────
docs/diagrams/*.png
docs/diagrams/*.svg
!docs/diagrams/*.puml
!docs/diagrams/*.mmd
