# ════════════════════════════════════════════════════════════════════════════════
# Nexus OS — Environment Template
# Copy to .env (gitignored) and fill in any keys you have. Every external
# provider has a deterministic mock fallback — the system boots end-to-end
# with this file unchanged.
# ════════════════════════════════════════════════════════════════════════════════

# ── Spring profile ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Postgres ────────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexus_os
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=nexus_secret

# ── Kafka ───────────────────────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ───────────────────────────────────────────────────────────────────────
SPRING_REDIS_URL=redis://localhost:6379

# ── Temporal ────────────────────────────────────────────────────────────────────
TEMPORAL_SERVICE_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexus-default-queue

# ── Qdrant ──────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LangChain4j / LLM provider ──────────────────────────────────────────────────
# Leave blank to use the deterministic mock provider.
# Set base-url to http://localhost:11434/v1 for Ollama (BYOM).
LANGCHAIN4J_OPEN_AI_API_KEY=
LANGCHAIN4J_OPEN_AI_BASE_URL=
LANGCHAIN4J_OPEN_AI_MODEL_NAME=gpt-4o-mini
LANGCHAIN4J_OPEN_AI_TEMPERATURE=0.7
LANGCHAIN4J_OPEN_AI_MAX_TOKENS=2048

# ── WhatsApp via Twilio ─────────────────────────────────────────────────────────
# Leave blank to use the mock WhatsApp client.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VALIDATE_WEBHOOK=true

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=nexus-os

# ── MCP + A2A ──────────────────────────────────────────────────────────────────
NEXUS_MCP_SERVER_PORT=8082
NEXUS_A2A_BASE_URL=http://localhost:8083
