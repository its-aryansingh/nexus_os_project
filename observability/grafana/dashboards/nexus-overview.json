  "panels": [
    {
      "type": "stat",
      "title": "Workflow runs / min",
      "targets": [{ "expr": "rate(nexus_workflow_runs_total[1m]) * 60", "refId": "A" }],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Tokens / min",
      "targets": [{ "expr": "rate(nexus_tokens_consumed_total[1m]) * 60", "refId": "A" }],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "type": "stat",
      "title": "USD / hour",
      "targets": [{ "expr": "rate(nexus_cost_usd_total[1h]) * 3600", "refId": "A" }],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Cache hit ratio (L1)",
      "targets": [{ "expr": "rate(nexus_cache_hits_total{layer=\"L1\"}[5m]) / (rate(nexus_cache_hits_total{layer=\"L1\"}[5m]) + rate(nexus_cache_misses_total{layer=\"L1\"}[5m]))", "refId": "A" }],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Workflow latency (P50 / P95 / P99)",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(nexus_workflow_latency_seconds_bucket[5m])) by (le))", "refId": "p50", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(nexus_workflow_latency_seconds_bucket[5m])) by (le))", "refId": "p95", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(nexus_workflow_latency_seconds_bucket[5m])) by (le))", "refId": "p99", "legendFormat": "P99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "targets": [{ "expr": "nexus_kafka_consumer_lag", "refId": "A", "legendFormat": "{{topic}}-{{partition}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Resilience4j circuit breaker state",
      "targets": [{ "expr": "resilience4j_circuitbreaker_state", "refId": "A", "legendFormat": "{{name}}-{{state}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Outbox dispatch lag (seconds)",
      "targets": [{ "expr": "nexus_outbox_lag_seconds", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    }
  ],
